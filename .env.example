# docker compose와 로컬 실행에서 쓰는 환경변수 예시. 실제 값은 .env에 두고 Git에 올리지 않는다.
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change-me
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ledger
SPRING_DATASOURCE_USERNAME=ledger
SPRING_DATASOURCE_PASSWORD=change-me
# OpenAI 초안 작성기를 켜려면 아래 키를 넣는다. 비워 두면 fixture 작성기만 동작한다.
OPENAI_API_KEY=
